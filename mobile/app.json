{
  "expo": {
    "name": "Yomu Reader",
    "slug": "nhentaidownlo-mobile",
    "version": "2.0.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "nhentaidownlo",
      "yomureader"
    ],
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101018"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#101018"
      },
      "package": "com.nhentaidownlo.mobile",
      "versionCode": 3,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "yomureader",
              "host": "gallery",
              "pathPrefix": "/"
            },
            {
              "scheme": "nhentaidownlo",
              "host": "gallery",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "nhentai.net",
              "pathPrefix": "/g/"
            },
            {
              "scheme": "https",
              "host": "www.nhentai.net",
              "pathPrefix": "/g/"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#101018"
        }
      ],
      "expo-secure-store",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      "expo-sqlite",
      "expo-updates",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Yomu Reader utilise Face ID pour déverrouiller l'application."
        }
      ],
      "./withAndroidDoh",
      "./withPrivacyScreenCapture",
      "./withAndroidReleaseKeystore",
      "./withDownloadForegroundService"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "glitchtipDsn": "",
      "router": {},
      "eas": {
        "projectId": "b10a22df-99f5-41c2-8352-b46160d23a2b"
      }
    },
    "owner": "nssmi",
    "updates": {
      "url": "https://u.expo.dev/b10a22df-99f5-41c2-8352-b46160d23a2b"
    }
  }
}
