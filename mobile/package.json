{
  "name": "nhentaidownlo-mobile",
  "main": "expo-router/entry",
  "version": "2.0.1",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "node test/bundle.mjs && node --test test/engine.test.cjs test/resumable.test.cjs test/sourcesHtml.test.cjs test/sources.test.cjs test/cloudSync.test.cjs test/tablerIcons.test.cjs test/withAndroidDoh.test.cjs test/stabilization.test.cjs test/privacyNative.test.cjs test/uiUx.test.cjs",
    "doctor": "npx expo-doctor",
    "prebuild:android": "npx expo prebuild --platform android",
    "setup:signing": "node scripts/setup-release-signing.cjs --apply",
    "verify:signing": "node scripts/verify-keystore.cjs",
    "build:apk": "node scripts/build-apk-arm64.cjs",
    "build:apk:unsigned": "cd android && gradlew.bat assembleRelease",
    "build:apk:debug": "cd android && gradlew.bat assembleDebug",
    "ui:check": "node scripts/ui-audit.cjs",
    "lint:android": "node scripts/android-gradle.cjs lintRelease",
    "release:check": "npx tsc --noEmit && npm run lint && npm run ui:check && npm test && npm run doctor && npm run lint:android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.116.0",
    "@tabler/icons-react-native": "^3.46.0",
    "base64-js": "^1.5.1",
    "date-fns": "^4.1.0",
    "expo": "^54.0.37",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-localization": "~17.0.9",
    "expo-navigation-bar": "~5.0.10",
    "expo-router": "~6.0.24",
    "expo-screen-capture": "~8.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-drawer-layout": "^4.1.12",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pager-view": "6.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "unrs-resolver": true,
    "expo-sqlite": true,
    "expo-crypto": true,
    "expo-web-browser": true,
    "expo-local-authentication": true,
    "@sentry/react-native": true,
    "@sentry/cli": true,
    "expo-updates": true
  },
  "private": true
}
