# Ces deux valeurs sont publiques par conception. Ne mettez jamais de clé service_role ici.
EXPO_PUBLIC_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REMPLACER
# Client OAuth Web Google (celui utilisé par Supabase et Credential Manager Android).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=VOTRE_CLIENT_ID.apps.googleusercontent.com

# Dans Supabase > Authentication > URL Configuration, ajoutez exactement :
# yomureader:///cloud-auth
# Optionnel : URL d'un proxy nHentai atteignable depuis un téléphone (jamais localhost).
# EXPO_PUBLIC_NHENTAI_MIRROR_URL=https://votre-proxy.exemple
