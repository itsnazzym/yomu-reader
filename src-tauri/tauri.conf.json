{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nHentai Launcher",
  "version": "0.1.0",
  "identifier": "com.nhentai.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nHentai Launcher & Downloader",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: asset: tauri: https://i.nhentai.net https://t.nhentai.net https://*.nhentai.net https://*.hitomi.la; connect-src 'self' https://nhentai.net https://*.nhentai.net http://localhost:*"
    }
  },
  "plugins": {
    "opener": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

