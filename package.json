{
  "name": "nhentai-launcher",
  "private": true,
  "version": "2.0.0",
  "description": "Yomu Reader — unofficial desktop reader & downloader",
  "author": "Your Name",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "concurrently -k \"vite\" \"wait-on http://localhost:1420 && electron .\"",
    "electron": "electron .",
    "proxy": "node proxy/nhentai-mirror.mjs",
    "check:electron": "node --check electron/main.cjs && node --check electron/preload.cjs",
    "test:electron": "node --test electron/lib/archiveReader.test.cjs electron/lib/secretVault.test.cjs electron/lib/secretsContract.test.cjs src/utils/globalId.test.cjs",
    "test:proxy": "node --test proxy/nhentai-mirror.test.mjs",
    "dist:win": "tsc && vite build && electron-builder --win",
    "tauri": "tauri"
  },
  "build": {
    "appId": "com.yomu.reader",
    "productName": "Yomu Reader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "YomuReader-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "xml2js": "^0.6.2",
    "yauzl": "^3.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/archiver": "^8.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
