# ==============================================================================
# nHentai Launcher (Desktop & Mobile) - .gitignore
# ==============================================================================

# --- Node / Package Managers ---
node_modules/
.pnpm-store/
.npm/
.yarn/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp
.pnp.js
.pnp.*

# --- Logs, Debugging & Performance ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Desktop Build & Distribution Outputs (Vite, Electron, Tauri) ---
dist/
dist-ssr/
release/
out/
build/
win-unpacked/
*.local
src-tauri/target/
**/target/
**/*.rs.bk
*.pdb
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm
*.snap

# --- Mobile (Expo & React Native) Artifacts ---
.expo/
expo-env.d.ts
.metro/
.cache/
metro-cache/

# Android Native Build
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/.idea/
mobile/android/*.iml
mobile/android/app/*.iml
mobile/android/local.properties
*.apk
*.aab
*.ap_
*.dex

# iOS Native Build
mobile/ios/Pods/
mobile/ios/build/
mobile/ios/*.xcworkspace/xcuserdata/
mobile/ios/*.xcodeproj/xcuserdata/
mobile/ios/*.xcodeproj/project.xcworkspace/xcuserdata/
*.ipa
*.dSYM/

# Android Keystores & Signing Keys
*.keystore
*.jks
debug.keystore
release.keystore
signing-key.properties

# --- Local Databases, Cache & Downloaded Media ---
downloads/
temp_downloads/
cache/
*.cbz
*.cbr
*.zip
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal

# --- Environment, Secrets & Credentials ---
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
api_keys.json
credentials.json
*.pem
*.key
*.cert

# --- Editor & IDE Configurations ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Accidental Expo / agent debug captures (never part of the app)
mobile/screen_*.png
mobile/test-bundle.js

# --- Test Coverage & Temporary Artifacts ---
coverage/
.nyc_output/
*.lcov
test-results/
.freebuff/
scratch/
scratch_*
*.scratch.*
backup*
*.bak
*.backup
*.tmp
*.temp
.agents/scratch/
