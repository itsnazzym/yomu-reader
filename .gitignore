# ==============================================================================
# nHentai Launcher Ecosystem - .gitignore
# ==============================================================================

# --- Node & Package Managers ---
node_modules/
.pnpm-store/
.npm/
.yarn/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp
.pnp.js
.pnp.*

# --- Logs, Metrics & Debugging ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Web & Next.js Builds (web/) ---
.next/
web/.next/
out/
web/out/
*.tsbuildinfo
next-env.d.ts
.vercel/

# --- Desktop Build & Packaging Outputs (Vite, Electron, Tauri) ---
dist/
dist-ssr/
release/
win-unpacked/
src-tauri/target/
**/target/
**/*.rs.bk
*.local
*.pdb
*.dmp
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm
*.snap

# --- Mobile (Expo & React Native) Artifacts ---
.expo/
mobile/.expo/
.metro/
metro-cache/
.cache/
expo-env.d.ts
mobile/expo-env.d.ts

# Android Native Builds & Intermediate Files
**/android/.gradle/
**/android/**/build/
**/android/**/.cxx/
**/android/**/.idea/
**/android/**/*.iml
**/android/**/local.properties
mobile/android/
*.apk
*.aab
*.ap_
*.dex

# iOS Native Builds & Pods
**/ios/Pods/
**/ios/**/build/
**/ios/**/*.xcworkspace/xcuserdata/
**/ios/**/*.xcodeproj/xcuserdata/
**/ios/**/*.xcodeproj/project.xcworkspace/xcuserdata/
mobile/ios/
*.ipa
*.dSYM/

# Android Keystores & Signing Keys
*.keystore
*.jks
debug.keystore
release.keystore
signing-key.properties

# --- Local Databases, Cache & Downloaded Media ---
downloads/
temp_downloads/
cache/
*.cbz
*.cbr
*.zip
*.tar.gz
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal

# --- Environment, Secrets & Credentials ---
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
api_keys.json
credentials.json
*.pem
*.key
*.cert

# --- Editor & IDE Configurations ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.cursor/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Test Artifacts & Bundles ---
coverage/
.nyc_output/
*.lcov
test-results/
mobile/screen_*.png
mobile/test-bundle.js
mobile/test/*.test.cjs

# --- Temporary & Scratch Files (Exclude actual code like backupStore.ts) ---
.freebuff/
scratch/
scratch_*
*.scratch.*
.agents/scratch/
*.bak
*.backup
*.tmp
*.temp
*~
backupdepackagejson.txt

